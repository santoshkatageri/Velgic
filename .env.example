# Velgic V3 — Supabase environment configuration (placeholder).
#
# Copy this file to `.env.local` and fill in your project's values.
# `.env*` files are gitignored; this placeholder is the only one committed.
#
# Get values locally:
#   supabase start
#   supabase status           # prints API URL + anon key under "API"
#
# Get values for a deployed project:
#   Supabase dashboard → Project Settings → API
#
# NOTE: the anon key is publishable. Rows are protected by Postgres RLS
# (see docs/architecture-v3.md §"Row-Level Security"). Never commit or
# share the service-role key.

# Public Supabase project URL (HTTP(S); local dev: http://localhost:54321)
VITE_SUPABASE_URL=

# Public anon (publishable) JWT — safe to ship to the client.
VITE_SUPABASE_ANON_KEY=
